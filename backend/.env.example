PORT=4000
MILVUS_ADDRESS=localhost:19530
# Required only when using a managed Milvus (e.g. Zilliz Cloud) instead of the
# local docker-compose stack — the API key/token for your cluster.
MILVUS_TOKEN=
MILVUS_COLLECTION=job_descriptions
# bge-small is a retrieval-tuned model (distinguishes "query" vs "passage"
# text) — noticeably more accurate for resume<->job matching than a generic
# sentence-similarity model like MiniLM, at the same 384 dimensions.
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
EMBEDDING_DIM=384
# How many candidates to pull from Milvus before filtering by match score.
# Set at/above your total job-description count so the "N matching roles"
# count reflects everything above the 10% relevance threshold, not an
# artificial cap. Capped at 1024 in code regardless — Zilliz Cloud serverless
# clusters silently return 0 results (no error) if the search `limit` exceeds
# 1024, so don't rely on setting this above that.
TOP_K=1000

# Required only for AI resume-improvement suggestions (/api/resume/suggest).
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Restricts CORS to this origin in production (e.g. https://your-app.vercel.app).
# Leave unset locally to allow all origins.
FRONTEND_ORIGIN=

# Required only for `npm run fetch:adzuna`, which pulls real job postings
# into data/jobs.json. Free signup at https://developer.adzuna.com/.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Two-letter country code Adzuna searches (us, gb, ca, au, de, in, ...).
ADZUNA_COUNTRY=us
# Pages fetched per query (50 results/page). Raise this once you've confirmed
# your Adzuna plan's rate limit comfortably covers QUERIES x this number.
ADZUNA_PAGES_PER_QUERY=4
